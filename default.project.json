{
	"name": "roblox-ts-plugin",
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json", "**/node_modules/**/node_modules"],
	"tree": {
		"$path": "out",
		"include": {
			"$path": "include",
			"node_modules": {
				"$className": "Folder",
				"@rbxts": {
					"$path": "node_modules/@rbxts"
				},
				"@rbxts-js": {
					"$path": "node_modules/@rbxts-js"
				},
				"@flamework": {
					"$path": "node_modules/@flamework"
				}
			}
		}
	}
}
